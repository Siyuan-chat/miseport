{
  "$defs": {
    "CanonicalMetadata": {
      "additionalProperties": false,
      "properties": {
        "source_format": {
          "const": "legacy-1.0",
          "title": "Source Format",
          "type": "string"
        },
        "snapshot_at": {
          "format": "date-time",
          "title": "Snapshot At",
          "type": "string"
        },
        "merchant": {
          "$ref": "#/$defs/Merchant"
        },
        "demo_only": {
          "title": "Demo Only",
          "type": "boolean"
        }
      },
      "required": [
        "source_format",
        "snapshot_at",
        "merchant",
        "demo_only"
      ],
      "title": "CanonicalMetadata",
      "type": "object"
    },
    "Merchant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "homepage": {
          "maxLength": 2048,
          "title": "Homepage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "homepage"
      ],
      "title": "Merchant",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "sku": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sku",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 10000,
          "title": "Description",
          "type": "string"
        },
        "category": {
          "default": "",
          "maxLength": 200,
          "title": "Category",
          "type": "string"
        },
        "price_jpy": {
          "minimum": 0,
          "title": "Price Jpy",
          "type": "integer"
        },
        "currency": {
          "default": "JPY",
          "title": "Currency",
          "type": "string"
        },
        "stock": {
          "$ref": "#/$defs/Stock",
          "default": "unknown"
        },
        "source_url": {
          "maxLength": 2048,
          "title": "Source Url",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "is_demo": {
          "title": "Is Demo",
          "type": "boolean"
        },
        "tax_included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Included"
        },
        "shipping_jpy": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shipping Jpy"
        },
        "stock_quantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stock Quantity"
        },
        "merchant_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant Id"
        },
        "merchant_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant Name"
        },
        "merchant_homepage": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant Homepage"
        },
        "evidence_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Url"
        },
        "image_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "gift_wrapping": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gift Wrapping"
        },
        "origin_prefecture": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Prefecture"
        },
        "caffeine_level": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caffeine Level"
        },
        "snapshot_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot At"
        }
      },
      "required": [
        "sku",
        "name",
        "price_jpy",
        "source_url",
        "updated_at",
        "is_demo"
      ],
      "title": "Product",
      "type": "object"
    },
    "Stock": {
      "enum": [
        "in_stock",
        "out_of_stock",
        "unknown"
      ],
      "title": "Stock",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "miseport/1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/CanonicalMetadata"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/Product"
      },
      "maxItems": 10000,
      "title": "Products",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "metadata",
    "products"
  ],
  "title": "CanonicalDocument",
  "type": "object"
}
