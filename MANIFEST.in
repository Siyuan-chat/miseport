# RELEASE BLOCKER (2026-10-29): CURRENT DEVELOPMENT MANIFEST IS NOT CLEAN FOR v0.1 MERCHANT RELEASE.
# This recursively includes internal docs, PROJECT_STATUS and historical references. BEFORE THE 11/10 TAG,
# use docs/RELEASE_PUBLICATION_POLICY.ja.md and Issue #10 to replace it with explicit PUBLIC files,
# migrate required sanitized fixtures, and inspect the actual sdist/wheel/source archives. NOT FOR PUBLIC RELEASE AS-IS.
include README.en.md README.ja.md Dockerfile Dockerfile.http .dockerignore PROJECT_STATUS.md SECURITY.md
recursive-include examples *.json *.csv
recursive-include docs *.md
recursive-include assets *.svg *.png *.ico *.json *.md
recursive-include site *.html
recursive-include scripts *.py
recursive-include references *.md *.json
recursive-include .github *.yml *.yaml
include cloudflare/*.mjs cloudflare/*.json cloudflare/*.jsonc cloudflare/*.yaml
prune cloudflare/node_modules
prune cloudflare/public
prune cloudflare/.wrangler
prune cloudflare/bundle
global-exclude *.pyc *.pyo
