# Public Python source distribution allowlist. Internal plans and legacy archive are excluded.
# GitHub's automatic source ZIP still requires the 11/10 pre-tag repository cleanup.
include README.md README.en.md README.ja.md LICENSE SECURITY.md CHANGELOG.md CONTRIBUTING.md
include Dockerfile Dockerfile.http .dockerignore .env.example
include MANIFEST.in
recursive-include examples *.json *.csv
recursive-include tests *.py
recursive-include tests/fixtures *.json
include docs/API.md docs/CATALOG.md docs/CLOUDFLARE.md docs/HTTP_SERVICE.md docs/SDK.md
include docs/ROADMAP.md docs/MUSE_CONNECT.ja.md docs/AGENT_GEO.ja.md
include docs/PRODUCT_STRATEGY.ja.md docs/CONNECTOR_ARCHITECTURE.ja.md docs/PLATFORM_COMPATIBILITY.ja.md
include docs/merchant/GUI_ALPHA_GUIDE.ja.md docs/merchant/SETUP_GUIDE.ja.md
include assets/original/miseport-logo.png assets/original/miseport-brand-board.png assets/original/provenance.json
include site/index.html
include scripts/build_cloudflare_demo.py scripts/check_site.py scripts/export_schemas.py
include scripts/package_cloudflare_pages.py scripts/probe_public_demo.py
include scripts/verify_distribution.py scripts/audit_release.py scripts/release_preflight.py scripts/launch_gui.py
include cloudflare/*.mjs cloudflare/*.json cloudflare/*.jsonc cloudflare/*.yaml
include cloudflare/pnpm-lock.yaml cloudflare/pnpm-workspace.yaml
include src/miseport/merchant_worker.js
prune references
prune cloudflare/node_modules
prune cloudflare/public
prune cloudflare/.wrangler
prune cloudflare/bundle
prune docs/evidence
global-exclude *.pyc *.pyo
